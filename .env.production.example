# Production environment configuration
# Copy this to .env.production and fill in the values after deploying infrastructure

# API Gateway URL (output from CDK deploy)
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-northeast-2.amazonaws.com/v1

# User ID for annotations
VITE_USER_ID=default

# Base path for S3 deployment
VITE_BASE_PATH=/apps/animation-reviewer/
