{
  "name": "avatars-animation-annotation-tool",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && VITE_BASE_PATH=/apps/animation-reviewer/ vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-manifest": "tsx scripts/generate-manifest.ts",
    "deploy:s3": "aws s3 sync dist/ s3://agent-station-avatars-staging/apps/animation-reviewer/ --delete",
    "deploy": "npm run build:prod && npm run deploy:s3"
  },
  "dependencies": {
    "@agent-station/avatar-types": "^1.0.9",
    "@agent-station/avatar-web": "^1.0.9",
    "@tanstack/react-virtual": "^3.13.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
